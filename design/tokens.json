{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MoTrend Design Tokens",
  "description": "Framework-neutral token specification for MoTrend web redesign and Flutter ThemeData mapping.",
  "tokens": {
    "color": {
      "surface": {
        "canvas": {
          "value": "#070708",
          "description": "Deep obsidian black for the root viewport canvas"
        },
        "primary": {
          "value": "#121214",
          "description": "Primary card and elevated container background"
        },
        "secondary": {
          "value": "#18181c",
          "description": "Secondary inset surface, input fields, and pill backgrounds"
        },
        "elevated": {
          "value": "#1f1f24",
          "description": "Floating elements, bottom sheets, and elevated dialogs"
        },
        "overlay": {
          "value": "rgba(7, 7, 8, 0.82)",
          "description": "Dimming backdrop for sheets and modals"
        },
        "glass": {
          "value": "rgba(18, 18, 20, 0.72)",
          "description": "Subtle glassmorphism for sticky headers and video controls"
        }
      },
      "border": {
        "subtle": {
          "value": "rgba(255, 255, 255, 0.08)",
          "description": "Barely perceptible divider and default card borders"
        },
        "default": {
          "value": "rgba(255, 255, 255, 0.14)",
          "description": "Standard border for interactive cards and pickers"
        },
        "strong": {
          "value": "rgba(255, 255, 255, 0.28)",
          "description": "Hover state and high-contrast separators"
        },
        "focus": {
          "value": "#8BFFB0",
          "description": "High-contrast focus ring for accessibility"
        }
      },
      "text": {
        "primary": {
          "value": "#FFFFFF",
          "description": "Primary titles, hero text, and button labels"
        },
        "secondary": {
          "value": "rgba(255, 255, 255, 0.72)",
          "description": "Body copy, subtitles, and descriptions"
        },
        "tertiary": {
          "value": "rgba(255, 255, 255, 0.44)",
          "description": "Timestamps, hints, and subtle metadata"
        },
        "inverse": {
          "value": "#070708",
          "description": "Text on top of bright primary action accents"
        }
      },
      "action": {
        "primary": {
          "value": "#8BFFB0",
          "description": "MoTrend signature mint green accent"
        },
        "primaryHover": {
          "value": "#72f29b",
          "description": "Hover state for primary action button"
        },
        "primaryActive": {
          "value": "#5ce087",
          "description": "Active pressed state for primary action button"
        },
        "primaryText": {
          "value": "#070708",
          "description": "High-contrast dark text inside primary button"
        },
        "secondary": {
          "value": "rgba(255, 255, 255, 0.10)",
          "description": "Background for secondary outline buttons"
        },
        "secondaryHover": {
          "value": "rgba(255, 255, 255, 0.16)",
          "description": "Hover background for secondary outline buttons"
        },
        "secondaryText": {
          "value": "#FFFFFF",
          "description": "Text for secondary buttons"
        }
      },
      "status": {
        "success": {
          "value": "#8BFFB0",
          "description": "Completed stage, positive credit balance, uploaded state"
        },
        "warning": {
          "value": "#FBBF24",
          "description": "Low credit balance, temporary notice, non-critical warning"
        },
        "error": {
          "value": "#F87171",
          "description": "Credit shortfall, upload failure, generation error"
        },
        "info": {
          "value": "#60A5FA",
          "description": "General informational callout"
        }
      }
    },
    "typography": {
      "fontFamily": {
        "primary": "\"Coolvetica\", Arial, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
      },
      "roles": {
        "display": {
          "fontSize": "38px",
          "lineHeight": "1.05",
          "fontWeight": "700",
          "letterSpacing": "-0.02em"
        },
        "titleLarge": {
          "fontSize": "24px",
          "lineHeight": "1.15",
          "fontWeight": "700",
          "letterSpacing": "-0.01em"
        },
        "titleMedium": {
          "fontSize": "18px",
          "lineHeight": "1.25",
          "fontWeight": "700",
          "letterSpacing": "0"
        },
        "bodyLarge": {
          "fontSize": "16px",
          "lineHeight": "1.40",
          "fontWeight": "400",
          "letterSpacing": "0"
        },
        "bodyMedium": {
          "fontSize": "14px",
          "lineHeight": "1.40",
          "fontWeight": "400",
          "letterSpacing": "0"
        },
        "bodySmall": {
          "fontSize": "12px",
          "lineHeight": "1.35",
          "fontWeight": "400",
          "letterSpacing": "0.01em"
        },
        "label": {
          "fontSize": "15px",
          "lineHeight": "1.00",
          "fontWeight": "700",
          "letterSpacing": "0.02em"
        }
      }
    },
    "spacing": {
      "4": "4px",
      "8": "8px",
      "12": "12px",
      "16": "16px",
      "20": "20px",
      "24": "24px",
      "32": "32px",
      "48": "48px"
    },
    "radius": {
      "pill": "9999px",
      "button": "14px",
      "card": "18px",
      "media": "14px",
      "sheet": "24px"
    },
    "elevation": {
      "none": "none",
      "low": "0 2px 8px rgba(0, 0, 0, 0.35)",
      "medium": "0 6px 20px rgba(0, 0, 0, 0.45)",
      "high": "0 12px 36px rgba(0, 0, 0, 0.60)"
    },
    "icon": {
      "16": "16px",
      "20": "20px",
      "24": "24px",
      "32": "32px"
    },
    "motion": {
      "duration": {
        "instant": "100ms",
        "fast": "200ms",
        "smooth": "350ms"
      },
      "easing": {
        "standard": "cubic-bezier(0.16, 1, 0.3, 1)",
        "in": "cubic-bezier(0.4, 0, 1, 1)",
        "out": "cubic-bezier(0, 0, 0.2, 1)"
      }
    }
  }
}
